# =============================================================================
# GRAYSON - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# =============================================================================
# Required Configuration
# =============================================================================

# OpenAI API Key (REQUIRED)
# Used for GPT-4o-mini LLM and text-embedding-3-small embeddings
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Optional Configuration
# =============================================================================

# Semantic Scholar API Key (OPTIONAL)
# Provides higher rate limits for academic paper search
# Free tier: 100 requests per 5 minutes
# With API key: Higher limits + additional metadata access
# Request a key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Discord Webhook URL (OPTIONAL)
# Used for user feedback notifications via /feedback command
# Create a webhook in your Discord server settings
# Leave empty to disable feedback feature
DISCORD_WEBHOOK_URL=

# =============================================================================
# ChromaDB Configuration (Future Use)
# =============================================================================

# ChromaDB Persistence Directory
# Currently not used for queries, reserved for future enhancements
# Vector database for paper caching and advanced search
CHROMA_PERSIST_DIRECTORY=./chroma_db

# =============================================================================
# Server Configuration
# =============================================================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Application environment
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
